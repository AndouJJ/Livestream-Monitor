# ─── Stream Monitor — environment variables ───────────────────────────────
#
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.
#
# DOWNLOAD_HOST_PATH
#   The folder on your HOST machine where downloads are saved.
#   The container always sees this as /app/downloads internally.
#
# Examples:
#   Windows D drive:    DOWNLOAD_HOST_PATH=D:\recordings
#   Linux / NAS:         DOWNLOAD_HOST_PATH=/mnt/nas/streams
#   Relative (default):  DOWNLOAD_HOST_PATH=./downloads
#
DOWNLOAD_HOST_PATH=./downloads

# AUTH_USERNAME / AUTH_PASSWORD
#   HTTP Basic Auth credentials required to access the site. REQUIRED for any
#   deployment reachable from the internet (e.g. Coolify) — without both set,
#   the app serves with no authentication at all.
#
AUTH_USERNAME=changeme
AUTH_PASSWORD=change-this-to-a-long-random-password
